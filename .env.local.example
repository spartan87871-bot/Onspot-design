# Copy this file to .env.local and fill in real values for live AI generation.
# Without these, the app runs entirely in demo mode using the samples in public/samples.

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# FLUX_MODEL=black-forest-labs/flux-schnell
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: brand this deployment differently (e.g. for a client-specific pitch link).
# Leave unset for the default public build ("Loom & Lustre AI", both studios).
# NEXT_PUBLIC_SITE_NAME=Vrajbhoomi Studio
# NEXT_PUBLIC_SITE_MODE=full          # "full" | "jewellery" | "blockprint"
